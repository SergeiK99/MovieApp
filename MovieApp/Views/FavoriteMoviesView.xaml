<UserControl x:Class="MovieApp.Views.FavoriteMoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieApp.Views">
    <UserControl.Resources>
        <!-- Удаляю локальный стиль MovieCardBorderStyle -->
    </UserControl.Resources>
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding FavoriteMovies}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MovieCardBorderStyle}" Margin="5" Padding="5">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick"
                                Command="{Binding DataContext.OpenMovieDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding PosterUrl}" Width="100" Height="150" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Margin="0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Year}" FontSize="14"/>
                                <TextBlock Text="{Binding Genres[0]}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="Удалить из избранного"
                                            Command="{Binding DataContext.RemoveFromFavoritesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="140"
                                            HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl> 