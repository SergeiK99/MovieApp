<Window x:Class="MovieApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovieApp.Views"
        mc:Ignorable="d"
        Title="MovieApp" Height="600" Width="900">
    <Window.Resources>
        <local:FavoriteButtonTextMultiConverter x:Key="FavoriteButtonTextMultiConverter"/>
        <local:FavoriteButtonVisibilityMultiConverter x:Key="FavoriteButtonVisibilityMultiConverter"/>
        <local:NotFavoriteButtonVisibilityMultiConverter x:Key="NotFavoriteButtonVisibilityMultiConverter"/>
    </Window.Resources>
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#F5F5F5" Margin="0,0,0,5" Height="40">
            <Button Content="Главная" Width="100" Margin="10,5,0,5" Name="MainPageButton" Click="MainPageButton_Click"/>
            <Button Content="Избранное" Width="100" Margin="10,5,0,5" Name="FavoritesPageButton" Click="FavoritesPageButton_Click"/>
        </StackPanel>
        <ContentControl Name="MainContent" />
    </DockPanel>
</Window>
