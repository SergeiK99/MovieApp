<Window x:Class="MovieApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovieApp"
        mc:Ignorable="d"
        Title="MovieApp" Height="600" Width="900">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10">
            <Button Content="Главная страница" Margin="0,0,10,0" FontFamily="Bahnschrift" FontSize="18"></Button>
            <Button Content="Избранное" FontFamily="Bahnschrift" FontSize="18"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10">
            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Название" Command="{Binding ChangeSortCommand}" CommandParameter="Title" Margin="0,0,5,0"/>
            <Button Content="Год" Command="{Binding ChangeSortCommand}" CommandParameter="Year" Margin="0,0,5,0"/>
            <Button Content="Жанр" Command="{Binding ChangeSortCommand}" CommandParameter="Genre" Margin="0,0,5,0"/>
        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Movies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding PosterUrl}" Width="100" Height="150" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Year}" FontSize="14"/>
                                    <TextBlock Text="{Binding Genres[0]}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
